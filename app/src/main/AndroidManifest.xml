<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- There is deliberately NO INTERNET permission: Android blocks this app from any network
         access, so typed text, clipboard and screenshots cannot leave the phone. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional, asked only if you turn on "Add screenshots to clipboard". -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Needed to check the signature of the new Ketik app when it asks for the data. -->
    <queries>
        <package android:name="id.my.blankpoof.ketik" />
    </queries>

    <application
        android:name=".KetikApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <service
            android:name=".KetikIME"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Hands one clipboard image to the app you paste into; not readable by anything else. -->
        <provider
            android:name=".ClipProvider"
            android:authorities="id.ketik.keyboard.clips"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Lets the new Ketik app (id.my.blankpoof.ketik) copy settings, learned words and
             clipboard over. Exported, but ExportProvider only answers that app, and only when it
             is signed with the same key as this one. -->
        <provider
            android:name=".ExportProvider"
            android:authorities="id.ketik.keyboard.export"
            android:exported="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
